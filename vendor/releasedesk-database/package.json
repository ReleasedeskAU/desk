{
  "name": "@releasedesk/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vendored Prisma schema/client for standalone Sentinel (Vercel) deploys.",
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/client/index.d.ts",
      "import": "./generated/client/index.js",
      "require": "./generated/client/index.js",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
