OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Clerk (required for sign-in) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Optional: set on Vercel to the URL users actually open (custom domain or alias).
# Required for Clerk session cookies on production — e.g. https://releasedesk.vercel.app
# NEXT_PUBLIC_APP_URL=https://releasedesk.vercel.app
NEXT_PUBLIC_APP_URL=

# Do NOT set NEXT_PUBLIC_CLERK_JS_URL unless you self-host clerk.browser.js — wrong value breaks sign-in.

# Postgres (Neon) — required for all API data (local + Vercel Production).
# Use the Neon *pooled* connection string for DATABASE_URL (host contains "-pooler").
# Use the Neon *direct* (non-pooler) connection string for DIRECT_URL.
# Both must be set on Vercel → Project → Settings → Environment Variables → Production.
# If Production is missing these, every page shows "Database temporarily unavailable".
DATABASE_URL=
DIRECT_URL=

# Upstash Redis (optional) — caches dashboard/inbox for ~60s to reduce Neon load.
# Free tier: ~500k commands/month. Only dashboard + inbox use Redis (not live-state polling).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Connector Engine — AES-256 key for encrypting stored connector credentials (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_ENCRYPTION_KEY=

# Connector Engine service (Railway/Render locally: http://localhost:3100)
CONNECTOR_ENGINE_URL=http://localhost:3100
CONNECTOR_ENGINE_API_KEY=

# Optional: privilege when Clerk metadata and DB User email do not map a role (readonly|editor|admin).
# Prefer Clerk publicMetadata.sentinelRole per user. Unmapped users fail closed to readonly if unset.
# SENTINEL_DEFAULT_AUTH_ROLE=editor

