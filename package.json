{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "node scripts/clean-and-generate-prisma.mjs && next build --webpack",
    "vercel-build": "node scripts/clean-and-generate-prisma.mjs && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test \"lib/voice/**/*.test.ts\" \"lib/voice/handlers/**/*.test.ts\" \"lib/voice/context-agent/**/*.test.ts\" \"lib/search-strengthen.test.ts\" \"lib/release-lifecycle-config.test.ts\" \"lib/release-lifecycle-config-version.test.ts\" \"lib/release-lifecycle-settings-ui.test.ts\" \"lib/release-lifecycle-transition.test.ts\" \"lib/release-form-save-alert.test.ts\"",
    "test:voice": "tsx --test \"lib/voice/**/*.test.ts\" \"lib/voice/handlers/**/*.test.ts\" \"lib/voice/context-agent/**/*.test.ts\" \"lib/search-strengthen.test.ts\"",
    "test:lifecycle": "tsx --test \"lib/release-lifecycle-config.test.ts\" \"lib/release-lifecycle-config-version.test.ts\" \"lib/release-lifecycle-settings-ui.test.ts\" \"lib/release-lifecycle-transition.test.ts\" \"lib/release-form-save-alert.test.ts\"",
    "db:push": "npm run db:push --prefix ./vendor/releasedesk-database",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && tsx prisma/seed.ts",
    "db:generate": "npm run generate --prefix ./vendor/releasedesk-database",
    "postinstall": "npm run db:generate",
    "sync:vendor-db": "node scripts/sync-vendor-database.mjs"
  },
  "prisma": {
    "schema": "vendor/releasedesk-database/prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@clerk/nextjs": "^7.5.12",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^1.52.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@mui/material-nextjs": "^9.1.1",
    "@prisma/client": "^6.19.3",
    "@prisma/nextjs-monorepo-workaround-plugin": "^7.8.0",
    "@releasedesk/database": "file:./vendor/releasedesk-database",
    "@upstash/redis": "^1.38.0",
    "csv-parse": "^5.6.0",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "openai": "^6.44.0",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
